# Dataset (heavy 3D meshes, PLYs, and keyframe data)
dataset/

# Python cache & build artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.env

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Editor & IDE settings
.vscode/
.idea/
*.swp
*~

# Temporary visualization outputs
*.html

# Papers (copyrighted PDFs, kept locally)
papers/

# Results and outputs (images, arrays, per-run files): kept locally, never pushed.
# LLR-LUS is research-only: nothing derived from it may leave this computer.
out/
*_out/
*.npy
_to_delete/

# Page templates are code and must be tracked (the *.html rule above ignores generated pages)
!*_template.html

# Hand-made annotations of LLR-LUS images (derived data, research-only)
goal/vlm/

# Generated notebooks that embed LLR-LUS-derived files (oracle contact depths / scales): rebuild with their make_*_notebook.py
studies/benchmark/kaggle/depth_benchmark_kaggle.ipynb
studies/benchmark/kaggle/selfp2ir_lus_oracle_kaggle.ipynb
